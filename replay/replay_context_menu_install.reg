Windows Registry Editor Version 5.00

; BattleShip replay viewer: "Replay episode" in the Explorer right-click menu (current user only, no admin).
; Generated by replay/make_context_menu_reg.py for:
;   interpreter  C:\Users\kill_\AppData\Local\Programs\Python\Python313\pythonw.exe
;   opener       C:\Users\kill_\Bureau\gitRepo\Smash_pc_port\BattleShip\replay\replay_open.pyw
; Import: double-click this file (or `reg import <file>`). Remove: replay_context_menu_uninstall.reg.
; Windows 11 lists classic entries under "Show more options" (Shift+F10).

; Folders (every folder; one selected item)
[HKEY_CURRENT_USER\Software\Classes\Directory\shell\BattleShipReplay]
@="Replay episode"
"MultiSelectModel"="Single"
"Icon"="C:\\Users\\kill_\\Bureau\\gitRepo\\Smash_pc_port\\BattleShip\\build-us\\Release\\BattleShip.exe,0"

[HKEY_CURRENT_USER\Software\Classes\Directory\shell\BattleShipReplay\command]
@="\"C:\\Users\\kill_\\AppData\\Local\\Programs\\Python\\Python313\\pythonw.exe\" \"C:\\Users\\kill_\\Bureau\\gitRepo\\Smash_pc_port\\BattleShip\\replay\\replay_open.pyw\" \"%1\""

; Files named exactly actions.jsonl
[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.jsonl\shell\BattleShipReplay]
@="Replay episode"
"MultiSelectModel"="Single"
"AppliesTo"="System.FileName:=actions.jsonl"
"Icon"="C:\\Users\\kill_\\Bureau\\gitRepo\\Smash_pc_port\\BattleShip\\build-us\\Release\\BattleShip.exe,0"

[HKEY_CURRENT_USER\Software\Classes\SystemFileAssociations\.jsonl\shell\BattleShipReplay\command]
@="\"C:\\Users\\kill_\\AppData\\Local\\Programs\\Python\\Python313\\pythonw.exe\" \"C:\\Users\\kill_\\Bureau\\gitRepo\\Smash_pc_port\\BattleShip\\replay\\replay_open.pyw\" \"%1\""
