    "landing_floor_x_max": -2700.0,
    "landing_tolerance": 1.0
   }
  },
  "canonical_json_sha256": "d9447d471b95dd59533dfd87192e8eff5e059a6fd42c8bc380e3e27ee6037196",
  "per_step": [
   "base = reward_v1(prev targets_remaining, cur, native clear): +1.0 per newly broken target, -0.001 per step, +10.0 on the native clear; newly broken must equal the remaining_mask bits turned off; no bit may turn back on",
   "sweep (one-time): first reply with {0,2,3,4,5,7,9} all broken: 3.0 + 2.0 * (3600 - n) / 3600, n = consumed_tick + 1 (1..3600, else violation)",
   "entry (live pairs P,E with x_P >= -2100 > x_E; o_0 is the first predecessor): y_c at x = -2100; over_wall y_c >= 2999; under_stage y_c <= -2849; through_face otherwise (anomaly); unpaired without a live predecessor",
   "qualified entry: over_wall AND the sweep complete in the entry step's reply; an exit (x_P < -2100 <= x_E) ends the visit's qualification",
   "landing: live, ground_air_state == 0, |y + 1950| <= 1, -3901 <= x <= -2699 (line 3); +2.0 once per episode on the first landing of a qualified visit; never on the native-failure step",
   "failure (btt_native_failure_v1 step only): -1.0 if a qualified landing happened on an earlier step, else -5.0; never on clear / truncation / interruption / startup / transport / lifecycle / administrative endings",
   "total = ((base + failure) + sweep) + crossing (bit-identical to v2 on a step without a route term)"
  ],
  "scope": [
   "contracts.observation = btt_policy_obs_v1 only",
   "environment.horizon = 3600 only",
   "no [curriculum]",
   "adds SSB64_RL_TARGET_DIAG=1 (reward-only read; never in the policy observation)",
   "canonical values enforced; resume across contracts refused",
   "native RNG never read"
  ],
  "numbers_decision": "frozen unchanged (+3, 0..2 timing, +2, -1, -5): ranking inequalities hold; no crossing / landing combination has ever been observed, so no offline evidence could justify other values; sparsity is a frequency problem, not a magnitude problem",
  "registered_property_change": "after a qualified landing, a fall before tick 2,600 outscores idling to the horizon (0.001 t + 1 < 3.6); kept deliberately (cheap attempts at the last left target); game-backed constructed demonstration: land+fall 14.138556 vs land+idle 12.200556"
 },
