{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "btt_policy_obs_v2_spatial and btt_spatial_v1 (M7g-b)",
 "description": "Machine-readable contract of the M7g-b policy observation v2 (block 'contract', generated from rl/m7g_obs.py contract_description(); 'contract_sha256' is its canonical digest) and the JSON Schema of the native btt_spatial_v1 reply object (SSB64_RL_SPATIAL=1). Human-readable: docs/rl_observation_v2_m7g.md.",
 "contract": {
  "contract": "btt_policy_obs_v2_spatial",
  "schema_version": 1,
  "space": "gymnasium.spaces.Dict",
  "key_order": [
   "segment_geometry",
   "segment_kind",
   "state",
   "target_geometry",
   "target_live"
  ],
  "keys": {
   "segment_geometry": {
    "shape": [
     32,
     8
    ],
    "dtype": "float32",
    "bounds": [
     "-inf",
     "inf"
    ],
    "fields": [
     "a_dx",
     "a_dy",
     "b_dx",
     "b_dy",
     "near_dx",
     "near_dy",
     "vel_x",
     "vel_y"
    ],
    "units": "native world units (TopN-relative); velocity in world units per tick",
    "normalized": true
   },
   "segment_kind": {
    "shape": [
     32,
     7
    ],
    "dtype": "float32",
    "bounds": [
     0.0,
     1.0
    ],
    "fields": [
     "present",
     "floor",
     "ceiling",
     "wall_facing_pos_x",
     "wall_facing_neg_x",
     "one_way",
     "moving"
    ],
    "values": "binary 0/1",
    "normalized": false
   },
   "state": {
    "shape": [
     15
    ],
    "dtype": "float32",
    "bounds": [
     "-inf",
     "inf"
    ],
    "fields": [
     "input_tick",
     "time_passed",
     "game_status",
     "btt_active",
     "targets_remaining",
     "fighter_valid",
     "position_x",
     "position_y",
     "air_velocity_x",
     "air_velocity_y",
     "ground_velocity_x",
     "facing_direction",
     "ground_air_state",
     "fighter_status_id",
     "jumps_used"
    ],
    "contract": "btt_policy_obs_v1",
    "byte_identical_to_v1": true,
    "normalized": true
   },
   "target_geometry": {
    "shape": [
     10,
     2
    ],
    "dtype": "float32",
    "bounds": [
     "-inf",
     "inf"
    ],
    "fields": [
     "dx",
     "dy"
    ],
    "units": "native world units (TopN-relative)",
    "rows": "M7f stable target IDs 0..9",
    "normalized": true
   },
   "target_live": {
    "shape": [
     10
    ],
    "dtype": "float32",
    "bounds": [
     0.0,
     1.0
    ],
    "values": "binary 0/1",
    "rows": "M7f stable target IDs 0..9",
    "normalized": false
   }
  },
  "flat_size": 525,
  "segments": {
   "slots": 32,
   "order": "native collision line id, then vertex-pair index",
   "count_on_stage": 24,
   "padding": "slots >= count: every geometry and kind value 0",
   "mario_reference": "TopN (position_x, position_y) of the paired v1 observation",
   "world_vertex_rule": "float32 stored vertex + float32 group translate when the group is translated (mpCollisionGetVertexPositionID)",
   "relative_geometry": "float64 then one cast to float32: a - p, b - p, (a - p) + clamp(((p - a) . (b - a)) / |b - a|^2, 0, 1) * (b - a), with p the Mario reference"
  },
  "inactive_encoding": {
   "broken_target": "target_geometry row 0, target_live 0",
   "teardown_reply": "native live = 0 (only the terminal reply of a fall): the last live platform / target state is held and info['spatial_stale'] is true"
  },
  "normalization": {
   "vecnormalize_norm_obs_keys": [
    "segment_geometry",
    "state",
    "target_geometry"
   ],
   "unnormalized_binary_keys": [
    "segment_kind",
    "target_live"
   ],
   "clip_obs": 10.0,
   "reward_normalization": false
  },
  "world": {
   "coordinates": "native world units, x right, y up",
   "map_bounds_blast_zone": [
    9600,
    -9600,
    9600,
    -9600
   ],
   "camera_bounds": [
    5000,
    -5000,
    5000,
    -5000
   ],
   "static_extent": {
    "x": [
     -3900,
     3300
    ],
    "y": [
     -4050,
     3000
    ]
   },
   "platform_surface_y": [
    1800,
    3600
   ],
   "normalization": "no fixed scaling; VecNormalize running statistics on the continuous keys"
  },
  "native_source": {
   "diagnostic": "btt_spatial_v1",
   "env": "SSB64_RL_SPATIAL=1",
   "status_key": "spatial_diag"
  },
  "information_class": "structured global state (more than one camera frame shows)",
  "excluded": [
   "optimal path",
   "preferred crossing",
   "target order",
   "TAS action",
   "'go left' indicator",
   "gateway / region labels",
   "distance along a handcrafted route",
   "future platform positions",
   "future game state",
   "reward shaping"
  ],
  "compatibility": "fresh models only; never load a btt_policy_obs_v1 checkpoint; v1 stays available and byte-identical"
 },
 "contract_sha256": "dcfd14b276c3d9f38f180888c132febb67ace39797bdef2aefb185e024c8c0cb",
 "network": {
  "network_id": "btt_policy_net_v2_multiinput_mlp64",
