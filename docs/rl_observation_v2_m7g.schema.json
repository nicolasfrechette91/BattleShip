   64
  ],
  "activation": "tanh",
  "features_extractor": "CombinedExtractor (flatten per key, KEY_ORDER)",
  "features_dim": 525,
  "parameters": 76818,
  "vecnormalize": {
   "norm_obs": true,
   "norm_obs_keys": [
    "segment_geometry",
    "state",
    "target_geometry"
   ],
   "norm_reward": false,
   "clip_obs": 10.0
  }
 },
